pandeflow.yikuaibanz.cn {
    encode gzip
    request_body {
        max_size 64KB
    }
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
    }
    redir / /demo 302
    reverse_proxy 127.0.0.1:8010 {
        transport http {
            dial_timeout 5s
            response_header_timeout 30s
        }
    }
}
